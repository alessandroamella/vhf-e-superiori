{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "extends": "//",
  "files": {
    "includes": [
      "!node_modules",
      "src/**",
      "*.js",
      "*.json",
      "scripts/**",
      "documents/**",
      "emails/**/*.html"
    ]
  },
  "overrides": [
    {
      "includes": ["emails/**/*.html"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnknownProperty": "off"
          }
        }
      }
    }
  ]
}
